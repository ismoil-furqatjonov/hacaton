# ============================================================
# DONOR — AI-POWERED BLOOD DONATION PLATFORM
# Environment Variables Namuna Fayli
# ============================================================

# 1. Supabase Konfiguratsiyasi (Ixtiyoriy - ko'rsatilmasa to'liq Demo rejimda ishlaydi)
# Loyihangizni https://supabase.com da yarating va Project Settings -> API dan oling:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google OAuth (Ixtiyoriy - Supabase Authentication -> Providers -> Google)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Tashqi AI API (Ixtiyoriy - Agar Google Gemini yoki tashqi LLM ga ulamoqchi bo'lsangiz)
# Loyiha o'zining o'rnatilgan DONOR AI Healthcare Engine bilimlar bazasiga ega.
# VITE_GEMINI_API_KEY=your-gemini-api-key

# 4. Tizim sozlamalari
VITE_APP_NAME="DONOR"
VITE_APP_SLOGAN="Bir donor — bir hayot."
VITE_APP_URL=http://localhost:3000
